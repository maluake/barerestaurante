# Copie para backend/.env e ajuste. NUNCA versione o arquivo .env.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://gastro:gastro@localhost:5432/gastro
# Em produção (HTTPS): SECURE_COOKIES=True
SECURE_COOKIES=False
LOG_LEVEL=INFO
# E-mail para alertas (padrão: imprime no console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=nao-responda@seu-dominio.com.br
# Assistente: "rules" (local). Chaves de IA ficam somente aqui, no backend.
ASSISTANT_PROVIDER=rules
ASSISTANT_API_KEY=
